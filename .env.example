# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/aegisflow

# JWT Secrets
JWT_ACCESS_SECRET=aegisflow_super_secret_access_key_change_in_production_min32chars
JWT_REFRESH_SECRET=aegisflow_super_secret_refresh_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Data encryption key for sensitive data at rest (32 bytes hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Third-party & External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
BUZZER_GATEWAY_URL=http://localhost:5000/api/mock/buzzer

# Messaging Provider: mock | twilio | msg91
SMS_PROVIDER=mock
VOICE_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# Cron Schedule Settings
RISK_ENGINE_CRON="*/30 * * * *"
ESCALATION_CHECK_CRON="*/1 * * * *"
SENSOR_HEALTH_CRON="*/5 * * * *"
